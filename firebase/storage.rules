rules_version = '2';
// Cloud Storage is not used by this version of the website (images ship with the site, or are linked by URL).
// Deny everything until an upload feature is built and these rules are deliberately opened for specific paths.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
